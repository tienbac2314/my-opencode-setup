 }
 
+function goalStatePath() {
+  if (process.env.OPENCODE_GOAL_STATE_PATH) return process.env.OPENCODE_GOAL_STATE_PATH
+  const dataHome = process.env.XDG_DATA_HOME
+    || (process.platform === "win32" && process.env.APPDATA ? process.env.APPDATA : join(homedir(), ".local", "share"))
+  return join(dataHome, "opencode-goal-plugin", "goals.json")
+}
+
+export async function persistedGoals(): Promise<Record<string, GoalSnapshot> | undefined> {
+  try {
+    const state: unknown = JSON.parse(await readFile(goalStatePath(), "utf8"))
+    if (!isRecord(state) || !isRecord(state.goals)) return undefined
+    const goals: Record<string, GoalSnapshot> = {}
+    for (const [sessionID, goal] of Object.entries(state.goals)) {
+      if (!isRecord(goal)) continue
+      const normalized = {
+        ...goal,
+        remainingTokens: goal.remainingTokens ?? (
+          typeof goal.tokenBudget === "number" && typeof goal.tokensUsed === "number"
+            ? Math.max(0, goal.tokenBudget - goal.tokensUsed)
+            : null
+        ),
+        sampledAt: typeof goal.sampledAt === "number"
+          ? goal.sampledAt
+          : typeof goal.lastAccountedAt === "number" ? goal.lastAccountedAt : currentEpochSeconds(),
+      }
+      if (isGoalSnapshot(normalized) && normalized.status !== "complete" && normalized.status !== "unmet") {
+        goals[sessionID] = normalized
+      }
+    }
+    return goals
+  } catch (error) {
+    return isRecord(error) && error.code === "ENOENT" ? {} : undefined
+  }
+}
