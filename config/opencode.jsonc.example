{
  "$schema": "https://opencode.ai/config.json",
  "shell": "pwsh",
  "logLevel": "INFO",
  "share": "manual",
  "autoupdate": "notify",
  "snapshot": true,
  "instructions": [
    "AGENTS.md"
  ],
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://tienbac.dpdns.org/v1",
        "apiKey": "YOUR_API_KEY_HERE",
        "modelsDiscovery": {
          "enabled": true
        }
      },
      "models": {}
    }
  },
  "model": "9router/ag/gemini-3.5-flash-low",
  "agent": {
    "general": {
      "model": "9router/ag/gemini-3.5-flash-low",
      "disable": true
    },
    "explore": {
      "model": "9router/ag/gemini-3.5-flash-low",
      "disable": true
    },
    "scout": {
      "model": "9router/ag/gemini-3.5-flash-low"
    }
  },
  "skills": {
    "paths": [
      "C:\\Users\\bacnt\\.config\\opencode\\skills"
    ]
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow"
  },
  "formatter": false,
  "lsp": true,
  "plugin": [
    "opencode-update-notifier",
    "@mem0/opencode-plugin",
    "oh-my-opencode-slim"
  ],
  "experimental": {
    "mcp_timeout": 60000
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 16384
  },
  "compaction": {
    "auto": true,
    "tail_turns": 20
  }
}
