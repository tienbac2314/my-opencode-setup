{
  "$schema": "https://opencode.ai/config.json",
  "shell": "pwsh",
  "logLevel": "INFO",
  "share": "manual",
  "autoupdate": "notify",
  "snapshot": false,
  "instructions": [
    "AGENTS.md"
  ],
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://tienbac.dpdns.org/v1",
        "apiKey": "YOUR_API_KEY_HERE",
        "modelsDiscovery": {
          "enabled": true
        }
      },
      "models": {}
    },
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:8787/v1",
        "apiKey": "YOUR_API_KEY_HERE",
        "modelsDiscovery": {
          "enabled": true
        }
      },
      "models": {}
    }
  },
  "model": "opencode/deepseek-v4-flash-free",
  "default_agent": "build",
  "agent": {
    "build": {
      "model": "opencode/deepseek-v4-flash-free"
    },
    "general": {
      "model": "opencode/deepseek-v4-flash-free",
      "disable": true
    },
    "explore": {
      "model": "opencode/deepseek-v4-flash-free",
      "disable": true
    },
    "compaction": {
      "model": "9router/ag/claude-opus-4-6-thinking"
    }
  },
  "skills": {
    "paths": [
      "C:\\Users\\bacnt\\.config\\opencode\\skills"
    ]
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow"
  },
  "formatter": false,
  "lsp": true,
  "plugin": [
    "opencode-update-notifier@0.3.3",
    "oh-my-opencode-slim@2.2.0",
    "@prevalentware/opencode-goal-plugin@0.1.24"
  ],
  "command": {
    "goal": {
      "description": "Set a session-scoped goal and auto-continue until complete.",
      "template": "$ARGUMENTS",
      "agent": "build"
    }
  },
  "experimental": {
    "mcp_timeout": 60000
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 16384
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 20000
  }
}
